# Copie para .env (ou exporte as variaveis no shell) antes de subir a API.
DB_URL=jdbc:postgresql://localhost:5432/rdn
DB_USER=rdn
DB_PASSWORD=rdn

# Segredo do JWT (HS256). Use pelo menos 32 bytes e nunca versione o valor real.
JWT_SECRET=rdn-api-dev-secret-key-change-me-32b
# Validade do token em segundos (default 3600).
JWT_EXPIRATION_SECONDS=3600
